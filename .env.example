# Only placeholders. Configure real secrets in ModelScope environment settings.
IMA_OPENAPI_CLIENTID=
IMA_OPENAPI_APIKEY=
IMA_KB_NAME=任德耀新建华为PC知识库
# Personal integration: IMA_KB_NAME=Alaraby的知识库
# Knowledge source: ima (live API) or local (official ZIP export)
KB_SOURCE=ima
LOCAL_KB_ZIP=/app/data/official-kb-v7.zip
LOCAL_KB_NAME=华为PC全板块深度知识库_v7（本地官方导出）
# Optional absolute Node path when node is not on PATH:
IMA_NODE_BIN=
# Provider and model are configurable; do not assume hosting includes inference.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_API_KEY=
# Full business readiness stays false until teammate generation/verification is integrated.

# Optional AI cover/atmosphere image generation (never product photography).
# Product images always come from ima; this is only for decorative backgrounds.
LLM_IMAGE_MODEL=wanx2.1-t2i-turbo
LLM_IMAGE_SIZE=768*1024
ENABLE_AI_COVER=1

# 热点搜索（联网取近期热梗）。不配也能跑，但会退回无密钥抓取（duckduckgo-lite / bing-html）；
# 容器环境里无密钥抓取常被挑战页挡住，表现为"搜索有返回但没有一条是关于网络用语的"→ 空列表。
# 配了密钥就走 Serper，keyed provider 优先级最高。
SERPER_API_KEY=

# Dify 选品总控 Agent（多Agent版）——密钥只从部署环境注入，仓库仅占位符
DIFY_API_BASE=https://api.dify.ai/v1
DIFY_API_KEY=
