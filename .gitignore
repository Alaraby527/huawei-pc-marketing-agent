__pycache__/
.pytest_cache/
.venv/
.env
.env.*
!.env.example
.runtime/
*.log
.DS_Store

data/*.zip

# the official library ZIP is tracked only in the ModelScope studio checkout
!data/official-kb-v7.zip

# built editor bundle (see scripts/build_studio.sh)

# LangGraph runtime checkpoints (local execution store, never committed)
agent_checkpoints.sqlite

# local runtime databases and their sqlite sidecar files (never committed)
data/*.db
data/*.db-*
data/*.sqlite
data/*.sqlite-*

# A malformed sqlite URL (e.g. "sqlite:/var/..." from a bad path join) creates a directory
# literally named "sqlite:". Keep it, and any stray URL-shaped path, out of the repo.
sqlite:*
*:/var/*
*.sqlite-shm
*.sqlite-wal
